#!/bin/sh
set -eu

export PYTHONPATH="/code:/code/python${PYTHONPATH:+:$PYTHONPATH}"
if [ -n "${ALIBABA_CLOUD_ACCESS_KEY_ID:-}" ]; then
  export OSS_ACCESS_KEY_ID="$ALIBABA_CLOUD_ACCESS_KEY_ID"
fi
if [ -n "${ALIBABA_CLOUD_ACCESS_KEY_SECRET:-}" ]; then
  export OSS_ACCESS_KEY_SECRET="$ALIBABA_CLOUD_ACCESS_KEY_SECRET"
fi
if [ -n "${ALIBABA_CLOUD_SECURITY_TOKEN:-}" ]; then
  export OSS_SESSION_TOKEN="$ALIBABA_CLOUD_SECURITY_TOKEN"
fi

exec /usr/bin/python3 /code/services/feedback/app.py \
  --host 0.0.0.0 \
  --port "${FC_CUSTOM_LISTEN_PORT:-9000}" \
  --runtime-dir /tmp/courseware-space-feedback
