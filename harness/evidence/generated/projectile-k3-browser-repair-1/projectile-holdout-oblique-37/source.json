{
  "title": "斜抛与平抛运动：速度能量比较纯物理模型",
  "domain": "projectile",
  "teaching_intent": "让学生在同一时间轴上观察斜抛上升与下降阶段：位置轨迹如何由采样状态驱动，速度矢量中水平分量近似不变而竖直分量先减后反向，加速度始终向下；动能、势能此消彼长而机械能保持稳定。学生可改变初速度、仰角、高度与演示倍率，通过暂停、慢放、拖动与回放比较顶点、落点、等高点附近的速度方向和能量分配，验证因果而非观看自动解题。",
  "model_js": "globalThis.coursewareModel=Object.freeze({sample(input){const sc=(input&&input.scenario)||{};const times=(input&&input.times_s)||[];const num=(v,d)=>{const n=Number(v);return Number.isFinite(n)?n:d;};const g=num(sc.g_m_s2,9.8);const m=num(sc.mass_kg,1);const v0=num(sc.speed_m_s,0);const x0=num(sc.x0_m,0);const y0=num(sc.y0_m,0);const mode=sc.mode==='horizontal'?'horizontal':'oblique';const deg=mode==='horizontal'?0:num(sc.angle_deg,0);const th=deg*Math.PI/180;const vx0=v0*Math.cos(th);const vy0=v0*Math.sin(th);const ax=0;const ay=-g;const disc=Math.max(0,vy0*vy0+2*g*y0);const tf=g>0?(vy0+Math.sqrt(disc))/g:0;const range=vx0*tf;const tA=vy0>0&&g>0?vy0/g:0;const hMax=y0+(g>0?Math.max(0,vy0*vy0/(2*g)):0);const opt=g>0?Math.atan2(v0,Math.sqrt(Math.max(0,v0*v0+2*g*y0)))*180/Math.PI:(v0>0?45:0);const z=n=>Object.is(n,-0)?0:n;const states=times.map(t0=>{let t=num(t0,0);if(t<0)t=0;if(tf>0&&t>tf)t=tf;const x=x0+vx0*t;const y=Math.max(0,y0+vy0*t-0.5*g*t*t);const vx=vx0;const vy=vy0-g*t;const ke=0.5*m*(vx*vx+vy*vy);const pe=m*g*y;const me=ke+pe;return{t_s:z(t),x_m:z(x),y_m:z(y),vx_m_s:z(vx),vy_m_s:z(vy),ax_m_s2:z(ax),ay_m_s2:z(ay),kinetic_j:z(ke),potential_j:z(pe),mechanical_j:z(me)};});return{states:states,events:{flight_time_s:z(tf),range_m:z(range),apex_time_s:z(tA),max_height_m:z(hMax),optimal_equal_height_angle_deg:z(opt)}};}});",
  "html": "<!doctype html>\n<html lang='zh-CN'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width,initial-scale=1'>\n<title>斜抛与平抛运动：速度能量比较纯物理模型</title>\n<style>\n*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#0f172a;color:#e5e7eb}main{max-width:1180px;margin:0 auto;padding:14px}h1{font-size:22px;margin:4px 0 10px}.grid{display:grid;grid-template-columns:340px 1fr;gap:12px}.card{background:#111827;border:1px solid #334155;border-radius:14px;padding:12px;box-shadow:0 8px 30px rgba(0,0,0,.25)}label{display:block;font-size:14px;margin:10px 0 6px;color:#cbd5e1}input,select,button{min-height:44px;min-width:44px;font-size:16px}input[type=range]{width:100%}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.btn{border:0;border-radius:12px;padding:10px 14px;background:#2563eb;color:white;cursor:pointer}.btn.secondary{background:#334155}.btn:active{transform:scale(.98)}.val{display:inline-block;min-width:64px;text-align:right;color:#a7f3d0}.stage{width:100%;height:auto;display:block;background:#020617;border-radius:12px;border:1px solid #334155}.read{line-height:1.65;font-size:14px;white-space:pre-wrap}.badge{display:inline-block;border-radius:999px;padding:4px 10px;background:#1e293b;margin:2px 4px 2px 0;border:1px solid #475569}.up{color:#fecaca}.down{color:#bfdbfe}.hint{color:#94a3b8;font-size:13px}.bar{height:16px;background:#1f2937;border-radius:999px;overflow:hidden;margin:4px 0 10px;border:1px solid #334155}.bar>i{display:block;height:100%;width:0}.k>i{background:#f97316}.p>i{background:#22c55e}.m>i{background:#a78bfa}@media(max-width:760px){.grid{grid-template-columns:1fr}h1{font-size:19px}main{padding:10px}.card{padding:10px}}\n</style>\n<!--HARNESS_PRIMITIVES-->\n<!--HARNESS_MODEL-->\n<!--HARNESS_INPUT-->\n</head>\n<body>\n<main>\n<h1>斜抛运动：上升与下降的速度、能量比较</h1>\n<div class='grid'>\n<section class='card' aria-label='控制面板'>\n<label>初速度 v0 <span class='val' id='vVal'></span></label>\n<input data-control id='speed' type='range' min='8' max='32' step='0.5'>\n<label>仰角 θ <span class='val' id='aVal'></span></label>\n<input data-control id='angle' type='range' min='10' max='80' step='1'>\n<label>初始高度 y0 <span class='val' id='hVal'></span></label>\n<input data-control id='height' type='range' min='0' max='12' step='0.5'>\n<label>演示倍率 <span class='val' id='rVal'></span></label>\n<select data-control id='rate'><option value='0.25'>0.25×</option><option value='0.5'>0.5×</option><option value='1' selected>1×</option><option value='2'>2×</option><option value='4'>4×</option></select>\n<div class='row' style='margin-top:12px'>\n<button class='btn' id='playBtn'>播放</button>\n<button class='btn secondary' data-replay id='replayBtn'>回放</button>\n<button class='btn secondary' id='pauseBtn'>暂停</button>\n</div>\n<div class='row' style='margin-top:10px'>\n<span class='badge'>物理时间 <b data-physical-time id='pt'></b></span>\n<span class='badge'>演示倍率 <b data-demo-time id='dt'></b></span>\n</div>\n<p class='hint'>拖动画布下方进度条可定位物理时间；慢放时观察顶点前后速度矢量翻转与能量迁移。</p>\n<input data-control id='seek' type='range' min='0' max='6' step='0.025' value='0' aria-label='物理时间拖动'>\n</section>\n<section class='card'>\n<svg class='stage' id='svg' viewBox='0 0 820 430' role='img' aria-label='斜抛轨迹、速度加速度矢量与能量比较'>\n<defs><marker id='arr' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'><path d='M 0 0 L 10 5 L 0 10 z' fill='#f8fafc'></path></marker>\n<marker id='arrR' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'><path d='M 0 0 L 10 5 L 0 10 z' fill='#ef4444'></path></marker></defs>\n<rect x='0' y='0' width='820' height='430' fill='#020617'></rect>\n<g id='world'></g><g id='overlay'></g>\n</svg>\n<div class='row'>\n<div style='flex:1;min-width:150px'><span class='badge up'>动能</span><div class='bar k'><i id='kBar'></i></div></div>\n<div style='flex:1;min-width:150px'><span class='badge down'>势能</span><div class='bar p'><i id='pBar'></i></div></div>\n<div style='flex:1;min-width:150px'><span class='badge'>机械能</span><div class='bar m'><i id='mBar'></i></div></div>\n</div>\n<div data-readout id='readout' class='read'></div>\n</section>\n</div>\n</main>\n<script>\n(function(){\n'use strict';\nvar P=CoursewarePrimitives,M=coursewareModel,H=globalThis.__HARNESS_INPUT__||{};\nvar DURATION=6,N=241,times=[],i;\nfor(i=0;i<N;i++){times.push(i*DURATION/(N-1));}\nvar base=(H&&H.scenario)?H.scenario:{angle_deg:37,g_m_s2:10,mass_kg:1.2,mode:'oblique',speed_m_s:22,x0_m:5,y0_m:0};\nvar scn={mode:'oblique',speed_m_s:num(base.speed_m_s,22),angle_deg:num(base.angle_deg,37),mass_kg:num(base.mass_kg,1.2),g_m_s2:num(base.g_m_s2,10),x0_m:num(base.x0_m,5),y0_m:num(base.y0_m,0)};\nvar data=M.sample({scenario:scn,times_s:times});\nvar curT=0,rate=1,playing=false,maxMech=1,sx=8,sy=8,groundY=372,leftX=44;\nvar $=function(s){return document.querySelector(s);};\nvar svg=$('#svg'),world=$('#world'),overlay=$('#overlay'),read=$('#readout');\nvar speed=$('#speed'),angle=$('#angle'),height=$('#height'),rateSel=$('#rate'),seek=$('#seek');\nfunction num(v,d){v=parseFloat(v);return isFinite(v)?v:d;}\nfunction clamp(v,a,b){return v<a?a:(v>b?b:v);}\nfunction fmt(v,u){return (isFinite(v)?v:0).toFixed(2)+u;}\nfunction stateAt(t){\n var s=data.states;if(!s||!s.length){return null;}\n if(t<=s[0].t_s){return s[0];}\n if(t>=s[s.length-1].t_s){return s[s.length-1];}\n var lo=0,hi=s.length-1,mid;\n while(hi-lo>1){mid=(lo+hi)>>1;if(s[mid].t_s<=t){lo=mid;}else{hi=mid;}}\n var a=s[lo],b=s[hi],w=(t-a.t_s)/((b.t_s-a.t_s)||1e-9),o={t_s:t};\n var keys=['x_m','y_m','vx_m_s','vy_m_s','ax_m_s2','ay_m_s2','kinetic_j','potential_j','mechanical_j'];\n for(var k=0;k<keys.length;k++){var key=keys[k];o[key]=a[key]+(b[key]-a[key])*w;}\n return o;\n}\nfunction X(x){return leftX+(x-scn.x0_m)*sx;}\nfunction Y(y){return groundY-y*sy;}\nfunction rebuild(){\n scn={mode:'oblique',speed_m_s:num(speed.value,22),angle_deg:num(angle.value,37),mass_kg:num(base.mass_kg,1.2),g_m_s2:num(base.g_m_s2,10),x0_m:num(base.x0_m,5),y0_m:num(height.value,0)};\n data=M.sample({scenario:scn,times_s:times});\n maxMech=1;for(i=0;i<data.states.length;i++){maxMech=Math.max(maxMech,data.states[i].mechanical_j,data.states[i].kinetic_j,data.states[i].potential_j);}\n var ev=data.events||{};var maxX=Math.max(30,(ev.range_m||30)+scn.x0_m+8);var maxY=Math.max(8,(ev.max_height_m||8)+scn.y0_m+4);\n sx=(800-leftX)/maxX;sy=(groundY-28)/maxY;\n $('#vVal').textContent=fmt(scn.speed_m_s,' m/s');$('#aVal').textContent=fmt(scn.angle_deg,'°');$('#hVal').textContent=fmt(scn.y0_m,' m');$('#rVal').textContent=rateSel.options[rateSel.selectedIndex].text;\n drawStatic();render(curT);\n}\nfunction drawStatic(){\n var s=data.states,ev=data.events||{},path='',pts='',j;\n for(j=0;j<s.length;j++){var p=s[j];path+=(j?' L':'M')+X(p.x_m).toFixed(1)+' '+Y(p.y_m).toFixed(1);if(j%12===0){pts+='<circle cx='+X(p.x_m).toFixed(1)+' cy='+Y(p.y_m).toFixed(1)+' r=2 fill=#64748b></circle>';}}\n var apex=stateAt(ev.apex_time_s||0),land=stateAt(ev.flight_time_s||0);\n world.innerHTML='<line x1=0 y1='+groundY+' x2=820 y2='+groundY+' stroke=#94a3b8 stroke-width=2></line>'+\n '<line x1='+leftX+' y1=24 x2='+leftX+' y2='+groundY+' stroke=#475569></line>'+\n '<text x=410 y=404 fill=#cbd5e1 text-anchor=middle font-size=14>水平位移 x</text>'+\n '<text x=18 y=210 fill=#cbd5e1 font-size=14 transform=rotate(-90 18 210)>高度 y</text>'+\n '<path d='+path+' fill=none stroke=#38bdf8 stroke-width=3></path>'+pts+\n (apex?'<circle cx='+X(apex.x_m)+' cy='+Y(apex.y_m)+' r=7 fill=#fde68a></circle><text x='+(X(apex.x_m)+10)+' y='+(Y(apex.y_m)-10)+' fill=#fde68a font-size=13>顶点</text>':'')+\n (land?'<circle cx='+X(land.x_m)+' cy='+Y(land.y_m)+' r=7 fill=#f87171></circle><text x='+(X(land.x_m)-52)+' y='+(Y(land.y_m)-12)+' fill=#fecaca font-size=13>落点</text>':'')+\n '<circle cx='+X(scn.x0_m)+' cy='+Y(scn.y0_m)+' r=6 fill=#a7f3d0></circle><text x='+(X(scn.x0_m)+8)+' y='+(Y(scn.y0_m)+18)+' fill=#a7f3d0 font-size=13>抛出点</text>';\n}\nfunction vector(x,y,vx,vy,scale,color,label){\n var ex=x+vx*scale,ey=y-vy*scale;\n return '<line x1='+x.toFixed(1)+' y1='+y.toFixed(1)+' x2='+ex.toFixed(1)+' y2='+ey.toFixed(1)+' stroke='+color+' stroke-width=3 marker-end=url(#arr)'+(color==='#ef4444'?'':'')+'></line><text x='+(ex+5).toFixed(1)+' y='+(ey-5).toFixed(1)+' fill='+color+' font-size=12>'+label+'</text>';\n}\nfunction render(t){\n curT=clamp(t,0,DURATION);var st=stateAt(curT),ev=data.events||{};if(!st){return;}\n var cx=X(st.x_m),cy=Y(st.y_m);var landed=st.y_m<=0.001&&curT>(ev.flight_time_s||999);\n var vscale=4.2,ascale=8;\n overlay.innerHTML='<circle cx='+cx.toFixed(1)+' cy='+cy.toFixed(1)+' r=10 fill=#fbbf24 stroke=#fff7ed stroke-width=2></circle>'+\n vector(cx,cy,st.vx_m_s,st.vy_m_s,vscale,'#f8fafc','v')+\n vector(cx,cy,0,st.vy_m_s,vscale,'#60a5fa','vy')+\n vector(cx,cy,st.vx_m_s,0,vscale,'#34d399','vx')+\n vector(cx,cy,st.ax_m_s2,st.ay_m_s2,ascale,'#ef4444','a')+\n '<text x=650 y=34 fill=#fde68a font-size=15>'+(landed?'已落地':(st.vy_m_s>=0?'上升阶段':'下降阶段'))+'</text>';\n $('#pt').textContent=P.formatPhysicalTime(curT);$('#dt').textContent=P.formatDemoRate(rate);seek.value=curT;\n $('#kBar').style.width=(100*st.kinetic_j/maxMech).toFixed(1)+'%';$('#pBar').style.width=(100*st.potential_j/maxMech).toFixed(1)+'%';$('#mBar').style.width=(100*st.mechanical_j/maxMech).toFixed(1)+'%';\n var nearApex=Math.abs(curT-(ev.apex_time_s||-99))<0.08;\n read.textContent='状态：'+(landed?'落地后样本保持 y=0':(st.vy_m_s>=0?'上升：竖直速度向上且被重力削减':'下降：竖直速度向下并增大'))+(nearApex?'｜正在顶点附近：vy 接近 0，vx 仍存在':'')+'\\n'+\n 't='+fmt(st.t_s,'s')+'  x='+fmt(st.x_m,'m')+'  y='+fmt(st.y_m,'m')+'\\n'+\n 'vx='+fmt(st.vx_m_s,'m/s')+'  vy='+fmt(st.vy_m_s,'m/s')+'  ax='+fmt(st.ax_m_s2,'m/s²')+'  ay='+fmt(st.ay_m_s2,'m/s²')+'\\n'+\n '动能='+fmt(st.kinetic_j,'J')+'  势能='+fmt(st.potential_j,'J')+'  机械能='+fmt(st.mechanical_j,'J')+'\\n'+\n '事件：顶点 '+P.formatPhysicalTime(ev.apex_time_s||0)+'，最大高度 '+fmt(ev.max_height_m,'m')+'；飞行 '+P.formatPhysicalTime(ev.flight_time_s||0)+'，射程 '+fmt(ev.range_m,'m')+'。';\n}\nvar tl=P.createTimeline({durationPhysicalS:DURATION,onChange:function(st){curT=st.physicalTimeS;rate=st.demoRate;playing=st.playing;$('#playBtn').textContent=playing?'暂停':'播放';render(curT);}});\ntl.pause();\n$('#playBtn').addEventListener('click',function(){if(playing){tl.pause();}else{tl.play();}});\n$('#pauseBtn').addEventListener('click',function(){tl.pause();});\n$('#replayBtn').addEventListener('click',function(){tl.replay();});\nrateSel.addEventListener('change',function(){tl.setDemoRate(clamp(parseFloat(rateSel.value)||1,0.1,4));});\nseek.addEventListener('input',function(){tl.pause();tl.seek(clamp(parseFloat(seek.value)||0,0,DURATION));});\n[speed,angle,height].forEach(function(el){el.addEventListener('input',function(){rebuild();tl.seek(clamp(curT,0,DURATION));});});\nsvg.addEventListener('pointerdown',function(e){var r=svg.getBoundingClientRect(),fx=(e.clientX-r.left)/r.width*820;var guess=clamp((fx-leftX)/(820-leftX),0,1)*DURATION;tl.pause();tl.seek(guess);});\ndocument.addEventListener('visibilitychange',function(){if(document.hidden){tl.pause();}});\nspeed.value=scn.speed_m_s;angle.value=scn.angle_deg;height.value=scn.y0_m;rebuild();tl.setDemoRate(1);tl.seek(0);\n})();\n</script>\n</body>\n</html>"
}
