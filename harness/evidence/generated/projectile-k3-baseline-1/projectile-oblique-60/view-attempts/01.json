  "raw": "{\"teaching_intent\":\"让学生把时间轴、轨迹、速度/加速度矢量与能量条形放在同一因果画面：调角度、初速、质量或模式后只重新采样，拖动或慢放观察最高点前后 vy 变号、ax 始终为零、ay 始终向下、动能与势能此消彼长而机械能保持不变，并比较不同角度的射程、最高点与等高度最优角。\",\"html\":\"<!doctype html><html lang='zh-CN'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>斜抛与平抛最高点、射程及能量比较模型</title><style>*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#f6f8fb;color:#172033}header{padding:14px 16px;background:#14213d;color:#fff}h1{font-size:20px;margin:0}.wrap{display:grid;grid-template-columns:minmax(320px,1fr) 340px;gap:12px;padding:12px}.card{background:#fff;border:1px solid #dde5f0;border-radius:14px;padding:12px;box-shadow:0 4px 18px #0001}.stage{min-height:430px}svg{width:100%;height:auto;min-height:360px;background:linear-gradient(#eef7ff 0 72%,#f3ead8 72%);border-radius:12px;touch-action:none}.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:10px 0}.ctl{min-width:44px;min-height:44px}.btn{border:0;border-radius:12px;background:#1d5cff;color:#fff;padding:12px 14px;font-size:15px}.btn.ghost{background:#e9eefb;color:#14213d}.btn.warn{background:#d94848}.lab{font-weight:700}.val{display:inline-block;min-width:72px;padding:8px 10px;border-radius:10px;background:#f0f4ff;border:1px solid #d6e0ff;font-variant-numeric:tabular-nums}.small{font-size:13px;color:#5b6478}.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.meter{height:16px;background:#edf1f7;border-radius:99px;overflow:hidden}.bar{height:100%;width:0}.k{background:#ff9f1c}.p{background:#2ec4b6}.m{background:#1d5cff}.pill{display:inline-block;border-radius:99px;padding:6px 10px;background:#eef3ff;margin:2px}.preset{min-width:52px;min-height:44px;border-radius:12px;border:1px solid #cbd8f2;background:#fff}.table{width:100%;border-collapse:collapse;font-size:13px}.table td,.table th{border-bottom:1px solid #e6ebf5;padding:7px;text-align:right}.table th:first-child,.table td:first-child{text-align:left}@media(max-width:760px){.wrap{grid-template-columns:1fr}.stage{min-height:390px}h1{font-size:18px}}@media(max-width:380px){.wrap{padding:8px}.card{padding:10px}.val{min-width:64px}.btn,.preset{padding:10px 12px}}</style></head><body><!--HARNESS_PRIMITIVES--><!--HARNESS_MODEL--><!--HARNESS_INPUT--><header><h1>斜抛与平抛最高点、射程及能量比较模型</h1><div class='small' style='color:#cfe0ff'>调参 → 模型重采样 → 拖时间轴验证：速度方向、加速度方向、能量转化与射程/最高点同时变化</div></header><main class='wrap'><section class='card stage'><svg id='svg' viewBox='0 0 640 380' role='img' aria-label='抛体运动场景'><defs><marker id='arrV' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#0a7f3f'/></marker><marker id='arrA' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#d00000'/></marker></defs><line x1='24' y1='336' x2='616' y2='336' stroke='#6b5d43' stroke-width='4'/><path id='traj' fill='none' stroke='#3553c7' stroke-width='3'/><circle id='ball' r='10' fill='#ffbf00' stroke='#8a5a00' stroke-width='2'/><line id='vvec' stroke='#0a7f3f' stroke-width='4' marker-end='url(#arrV)'/><line id='avec' stroke='#d00000' stroke-width='4' marker-end='url(#arrA)'/><g id='marks' font-size='12' fill='#203050'></g><text id='hint' x='30' y='26' font-size='13' fill='#3a4763'>绿箭：速度方向；红箭：加速度方向。落地后停在地面上。</text></svg><div class='row'><button id='play' class='btn ctl'>播放</button><button id='pause' class='btn ghost ctl'>暂停</button><button data-replay id='replay' class='btn warn ctl'>回放</button><span class='lab'>物理时间</span><span class='val' data-physical-time id='pt'>0.00 s</span><span class='lab'>演示倍率</span><span class='val' data-demo-time id='dt'>1.0×</span></div><div class='row'><span class='lab'>拖动时间</span><input id='seek' class='ctl' type='range' min='0' max='12' step='0.01' value='0' style='flex:1;min-width:180px'><input id='rate' class='ctl' type='range' min='0.1' max='4' step='0.1' value='1'><span class='small'>慢放/快进只改演示倍率，不改物理时间</span></div><div class='card' style='padding:10px'><b>状态读数</b><div data-readout id='readout' class='small' style='margin-top:6px;line-height:1.7'>等待采样…</div></div></section><aside class='card'><div class='grid'><label>抛射角 θ°<input data-control id='ang' class='ctl' type='range' min='5' max='85' step='1' value='60' style='width:100%'></label><label>初速 v₀ m/s<input data-control id='spd' class='ctl' type='range' min='5' max='40' step='1' value='25' style='width:100%'></label><label>质量 kg<input data-control id='mass' class='ctl' type='range' min='0.2' max='5' step='0.1' value='1.5' style='width:100%'></label><label>模式<select data-control id='mode' class='ctl' style='width:100%'><option value='oblique'>斜抛</option><option value='horizontal'>平抛/水平出射</option></select></label></div><div class='row'><span class='pill'>θ=<b id='angv'>60</b>°</span><span class='pill'>v₀=<b id='spdv'>25</b> m/s</span><span class='pill'>m=<b id='massv'>1.5</b> kg</span></div><div class='card' style='padding:10px;background:#fbfcff'><b>能量因果条</b><div class='small'>动能</div><div class='meter'><div id='ek' class='bar k'></div></div><div class='small'>势能</div><div class='meter'><div id='ep' class='bar p'></div></div><div class='small'>机械能</div><div class='meter'><div id='em' class='bar m'></div></div></div><div><b>同条件角度比较</b><div class='row' id='presets'></div><table class='table'><thead><tr><th>角度</th><th>最高点m</th><th>射程m</th><th>飞行s</th></tr></thead><tbody id='cmp'></tbody></table><div class='small' id='opt'></div></div><p class='small'>结论不由页面算出：所有位置、速度、加速度、能量和事件都来自 coursewareModel.sample。试试 30°/45°/60°/75°，再看等高度最优角提示。</p></aside></main><script>const $=id=>document.getElementById(id);const confirmed=globalThis.__HARNESS_INPUT__||{};const base=confirmed.scenario||confirmed;let data=null,timeline=null,lastT=-1;const DUR=12,STEP=0.02;function axis(){const a=[];for(let t=0;t<DUR+1e-9;t+=STEP)a.push(+t.toFixed(2));return a}function sc(){return{...base,angle_deg:+$('ang').value,speed_m_s:+$('spd').value,mass_kg:+$('mass').value,mode:$('mode').value}}function fmt(n,d=2){return Number(n).toFixed(d)}function idx(t){const s=data.states;let i=Math.round(t/STEP);if(i<0)i=0;if(i>=s.length)i=s.length-1;return i}function layout(){const e=data.events,s=data.states;const W=590,H=300,x0=24,y0=336;const sx=W/Math.max(20,(e.range_m||0)*1.18);const sy=H/Math.max(8,(e.max_height_m||0)*1.35);const k=Math.min(sx,sy);let d='';s.forEach((p,i)=>{d+=(i?'L':'M')+(x0+p.x_m*k).toFixed(1)+' '+(y0-p.y_m*k).toFixed(1)+' '});$('traj').setAttribute('d',d);const apex=e.apex_time_s?stAt(e.apex_time_s):s[0];const end=s[s.length-1];$('marks').innerHTML='<text x='+(x0+apex.x_m*k-18)+' y='+(y0-apex.y_m*k-10)+'>最高点 '+fmt(e.max_height_m,1)+'m</text><circle cx='+(x0+apex.x_m*k)+' cy='+(y0-apex.y_m*k)+' r='4' fill='#7b2cbf'/><text x='+(x0+end.x_m*k-22)+' y='+(y0-16)+'>射程 '+fmt(e.range_m,1)+'m</text><circle cx='+(x0+end.x_m*k)+' cy='+y0+' r='4' fill='#d94848'/>';return{k,x0,y0}}function stAt(t){return data.states[idx(t)]}function draw(t){const L=layout();const s=stAt(t);const bx=L.x0+s.x_m*L.k,by=L.y0-s.y_m*L.k;$('ball').setAttribute('cx',bx);$('ball').setAttribute('cy',by);const vs=0.9;const vx=Math.max(-90,Math.min(90,s.vx_m_s*vs)),vy=Math.max(-90,Math.min(90,s.vy_m_s*vs));$('vvec').setAttribute('x1',bx);$('vvec').setAttribute('y1',by);$('vvec').setAttribute('x2',bx+vx);$('vvec').setAttribute('y2',by-vy);const as=6;$('avec').setAttribute('x1',bx);$('avec').setAttribute('y1',by);$('avec').setAttribute('x2',bx+s.ax_m_s2*as);$('avec').setAttribute('y2',by-s.ay_m_s2*as);const em=Math.max(1e-9,s.mechanical_j);$('ek').style.width=(100*s.kinetic_j/em)+'%';$('ep').style.width=(100*s.potential_j/em)+'%';$('em').style.width=(100*s.mechanical_j/em)+'%';const e=data.events;$('readout').innerHTML='t='+fmt(s.t_s)+'s；x='+fmt(s.x_m)+'m，y='+fmt(s.y_m)+'m<br>vx='+fmt(s.vx_m_s)+'m/s，vy='+fmt(s.vy_m_s)+'m/s；ax='+fmt(s.ax_m_s2)+'，ay='+fmt(s.ay_m_s2)+'m/s²<br>动能 '+fmt(s.kinetic_j,1)+'J，势能 '+fmt(s.potential_j,1)+'J，机械能 '+fmt(s.mechanical_j,1)+'J<br>事件：最高点 '+fmt(e.max_height_m)+'m @ '+fmt(e.apex_time_s)+'s；射程 '+fmt(e.range_m)+'m；飞行 '+fmt(e.flight_time_s)+'s；等高度最优角 '+fmt(e.optimal_equal_height_angle_deg,1)+'°'}function refresh(){data=coursewareModel.sample({scenario:sc(),times_s:axis()});$('angv').textContent=$('ang').value;$('spdv').textContent=$('spd').value;$('massv').textContent=$('mass').value;$('seek').value=0;compare();if(timeline){timeline.pause();timeline.seek(0)}draw(0)}function compare(){const rows=[30,45,60,75].map(a=>coursewareModel.sample({scenario:{...sc(),angle_deg:a,mode:'oblique'},times_s:[0]}).events);$('cmp').innerHTML=rows.map((e,i)=>'<tr><td>'+[30,45,60,75][i]+'°</td><td>'+fmt(e.max_height_m,1)+'</td><td>'+fmt(e.range_m,1)+'</td><td>'+fmt(e.flight_time_s,2)+'</td></tr>').join('');$('opt').textContent='模型给出的等高度最优角：'+fmt(data.events.optimal_equal_height_angle_deg,1)+'°'}function sync(st){$('pt').textContent=CoursewarePrimitives.formatPhysicalTime(st.physicalTimeS);$('dt').textContent=CoursewarePrimitives.formatDemoRate(st.demoRate);if(Math.abs(st.physicalTimeS-lastT)>1e-6){$('seek').value=st.physicalTimeS;lastT=st.physicalTimeS}draw(Math.min(DUR,st.physicalTimeS))}function init(){refresh();timeline=CoursewarePrimitives.createTimeline({durationPhysicalS:DUR,onChange:sync});$('play').onclick=()=>timeline.play();$('pause').onclick=()=>timeline.pause();$('replay').onclick=()=>timeline.replay();$('rate').oninput=e=>timeline.setDemoRate(+e.target.value);$('seek').oninput=e=>{lastT=+e.target.value;timeline.seek(+e.target.value)};['ang','spd','mass','mode'].forEach(id=>$(id).addEventListener('input',refresh));[30,45,60,75].forEach(a=>{const b=document.createElement('button');b.className='preset ctl';b.textContent=a+'°';b.onclick=()=>{$('ang').value=a;$('mode').value='oblique';refresh();timeline.replay()};$('presets').appendChild(b)});document.addEventListener('visibilitychange',()=>{if(document.hidden)timeline.pause()});draw(0)}init();</script></body></html>\"}",
