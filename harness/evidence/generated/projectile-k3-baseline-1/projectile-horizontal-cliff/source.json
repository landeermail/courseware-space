{
  "title": "平抛与斜抛运动纯物理模型",
  "domain": "projectile",
  "teaching_intent": "让学生在水平抛出场景中亲自改变高度、初速度、角度/模式与重力，拖动物理时间并慢放，观察不可见过程：水平分速度近似保持、竖直分速度与向下加速度/重力的因果、速度矢量方向随时间偏转、动能增加势能减少而机械能保持，以及落地时间与射程如何由初始条件和参数共同决定。",
  "model_js": "globalThis.coursewareModel=Object.freeze({sample:function(input){var sc=(input&&input.scenario)||{};var ts=(input&&input.times_s)||[];function N(v,d){var n=Number(v);return isFinite(n)?n:d;}var g=N(sc.g_m_s2,10),m=N(sc.mass_kg,1),v0=N(sc.speed_m_s,0),x0=N(sc.x0_m,0),y0=N(sc.y0_m,0),deg=N(sc.angle_deg,0),mode=String(sc.mode||'oblique');var th=(mode==='horizontal'?0:deg)*Math.PI/180;var vx0=v0*Math.cos(th),vy0=v0*Math.sin(th);var disc=vy0*vy0+2*g*y0;if(disc<0)disc=0;var tf=g>0?(vy0+Math.sqrt(disc))/g:0;var range=x0+vx0*tf;var apexT=(g>0&&vy0>0)?vy0/g:0;var maxH=(g>0&&vy0>0)?y0+vy0*vy0/(2*g):y0;var opt=(g>0&&v0>0)?45:0;function st(t){t=N(t,0);if(t<0)t=0;if(g>0&&t>tf){return{t_s:t,x_m:range,y_m:0,vx_m_s:0,vy_m_s:0,ax_m_s2:0,ay_m_s2:0,kinetic_j:0,potential_j:0,mechanical_j:0};}var x=x0+vx0*t;var y=y0+vy0*t-0.5*g*t*t;var vy=vy0-g*t;if(g>0&&y<0)y=0;var ke=0.5*m*(vx0*vx0+vy*vy);var pe=m*g*y;return{t_s:t,x_m:x,y_m:y,vx_m_s:vx0,vy_m_s:vy,ax_m_s2:0,ay_m_s2:g>0?-g:0,kinetic_j:ke,potential_j:pe,mechanical_j:ke+pe};}var states=[];for(var i=0;i<ts.length;i++)states.push(st(ts[i]));return{states:states,events:{flight_time_s:tf,range_m:range,apex_time_s:apexT,max_height_m:maxH,optimal_equal_height_angle_deg:opt}};}});",
  "html": "<!doctype html><html lang=zh-CN><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><!--HARNESS_PRIMITIVES--><!--HARNESS_MODEL--><!--HARNESS_INPUT--><title>平抛与斜抛运动纯物理模型</title><style>*{box-sizing:border-box}body{margin:0;font-family:system-ui,sans-serif;background:#f6f8fb;color:#16233a}header{padding:12px 14px;background:#12315e;color:#fff}h1{font-size:18px;margin:0}main{display:grid;grid-template-columns:340px 1fr;gap:12px;padding:12px}.card{background:#fff;border:1px solid #dbe3ee;border-radius:14px;padding:12px;box-shadow:0 2px 8px #0001}label{display:block;margin:10px 0 4px;font-weight:700}input,select,button{min-height:44px;min-width:44px;font-size:16px}input[type=range]{width:100%}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.btn{border:0;border-radius:10px;background:#1c64d1;color:#fff;padding:10px 14px}.btn.secondary{background:#eef3fb;color:#173b6d}.btn.warn{background:#b00020;color:#fff}#stage{height:560px}svg{width:100%;height:100%;display:block;background:linear-gradient(#fff,#f8fbff);border-radius:12px}.num{font-variant-numeric:tabular-nums}.read{font-size:15px;line-height:1.55;background:#0d1b2a;color:#eaf2ff;border-radius:10px;padding:10px;white-space:pre-wrap}.hint{font-size:13px;color:#52617a}.bar{height:14px;background:#e8edf5;border-radius:99px;overflow:hidden;margin:3px 0 8px}.bar>i{display:block;height:100%}.k>i{background:#0a8f5b}.p>i{background:#d97706}.m>i{background:#5461d8}@media(max-width:760px){main{grid-template-columns:1fr;padding:8px}#stage{height:430px}h1{font-size:16px}}</style></head><body><header><h1>平抛与斜抛运动：速度方向、落地时间、射程与能量</h1></header><main><section class=card><div class=hint>只拖动时间，不自动给答案；观察矢量、读数与事件的同步变化。</div><label>抛出高度 y0 <b id=vH class=num>20</b> m</label><input data-control id=cH type=range min=1 max=60 step=0.5 value=20><label>初速度大小 <b id=vS class=num>10</b> m/s</label><input data-control id=cS type=range min=1 max=40 step=0.5 value=10><label>模式</label><select data-control id=cM><option value=horizontal selected>平抛 horizontal：角度固定0°</option><option value=oblique>斜抛 oblique：可调角度</option></select><label>抛射角 <b id=vA class=num>0</b>°</label><input data-control id=cA type=range min=-80 max=80 step=1 value=0 disabled><label>重力加速度 g <b id=vG class=num>10</b> m/s²</label><input data-control id=cG type=range min=1 max=25 step=0.1 value=10><div class=row style=margin-top:12px><button class=btn id=bPlay>播放</button><button class='btn secondary' id=bPause>暂停</button><button class='btn warn' data-replay id=bReplay>回放</button></div><label>物理时间拖动</label><input id=scrub type=range min=0 max=2 step=0.01 value=0><label>演示倍率 <span data-demo-time id=demo class=num>×1.00</span></label><input id=rate type=range min=0.1 max=4 step=0.1 value=1><div class=hint>物理时间：<b data-physical-time id=pt class=num>0.00 s</b>；慢放只改变演示节奏，不改物理过程。</div><div class=read data-readout id=ro>等待模型采样…</div><div style=margin-top:8px><b>能量</b><div>动能</div><div class='bar k'><i id=eK></i></div><div>势能</div><div class='bar p'><i id=eP></i></div><div>机械能</div><div class='bar m'><i id=eM></i></div></div></section><section class=card id=stage><svg id=sv viewBox='0 0 820 560'><defs><marker id=ah markerWidth=8 markerHeight=8 refX=6 refY=3 orient=auto><path d='M0 0 L6 3 L0 6 Z' fill=#0a6cff></path><marker id=ar markerWidth=8 markerHeight=8 refX=6 refY=3 orient=auto><path d='M0 0 L6 3 L0 6 Z' fill=#d00000></path></defs><rect x=0 y=0 width=820 height=560 fill=none></rect><g id=grid></g><line id=ground x1=0 y1=0 x2=0 y2=0 stroke='#5b6b80' stroke-width=3></line><polyline id=traj fill=none stroke='#24425f' stroke-width=3></polyline><circle id=apex r=6 fill='#7b2cbf' opacity=0.9></circle><circle id=land r=7 fill='#b00020'></circle><line id=vel stroke=#0a6cff stroke-width=4 marker-end='url(#ah)'></line><line id=acc stroke=#d00000 stroke-width=4 stroke-dasharray='7 5' marker-end='url(#ar)'></line><circle id=ball r=10 fill=#ffb703 stroke=#7a4b00 stroke-width=2></circle><text id=labV font-size=13 fill=#0a4fd0>速度 v：切线方向</text><text id=labA font-size=13 fill=#a00000>加速度/合力：向下</text></svg><div class=hint>蓝箭头=速度方向；红虚箭头=加速度与合力方向。紫点=最高点事件，红点=落地事件；能量条验证因果而非代算结论。</div></section></main><script>'use strict';var $=function(id){return document.getElementById(id)};var baseIn=globalThis.__HARNESS_INPUT__||{};var base=baseIn.scenario||baseIn||{angle_deg:0,g_m_s2:10,mass_kg:1,mode:'horizontal',speed_m_s:10,x0_m:0,y0_m:20};var tl=null,data=null,T=1,W=820,H=560,ml=48,mr=18,mt=18,mb=44,ox=ml,oy=H-mb,sc=1;function grid(n,d){var a=[],i;for(i=0;i<n;i++)a.push(d*i/(n-1));return a}function num(x,d){return(typeof x==='number'&&isFinite(x))?x:d}function controls(){var mode=$('cM').value;$('cA').disabled=mode==='horizontal';$('vH').textContent=$('cH').value;$('vS').textContent=$('cS').value;$('vA').textContent=$('cA').value;$('vG').textContent=$('cG').value;var s={};for(var k in base)s[k]=base[k];s.mode=mode;s.y0_m=parseFloat($('cH').value);s.speed_m_s=parseFloat($('cS').value);s.g_m_s2=parseFloat($('cG').value);s.angle_deg=mode==='horizontal'?0:parseFloat($('cA').value);s.mass_kg=num(base.mass_kg,1);s.x0_m=num(base.x0_m,0);return s}function sample(scenario){var probe=coursewareModel.sample({scenario:scenario,times_s:grid(3,8)});T=num(probe.events&&probe.events.flight_time_s,0);if(!(T>0))T=1;return coursewareModel.sample({scenario:scenario,times_s:grid(241,T)})}function idx(t){var n=data.states.length;var i=Math.round((t/T)*(n-1));if(i<0)i=0;if(i>n-1)i=n-1;return i}function build(){data=sample(controls());var ev=data.events||{};var x0=num(data.states[0].x_m,0),maxX=Math.max(1,num(ev.range_m,1)+x0);var maxY=Math.max(1,num(ev.max_height_m,0),num(base.y0_m,0));sc=Math.min((W-ml-mr)/maxX,(H-mt-mb)/maxY);var gr='';for(var gx=0;gx<=maxX;gx+=Math.max(5,Math.round(maxX/8))){gr+='<line x1='+(ox+gx*sc)+' y1='+mt+' x2='+(ox+gx*sc)+' y2='+oy+' stroke=#e3e9f3></line>'}for(var gy=0;gy<=maxY;gy+=Math.max(5,Math.round(maxY/6))){gr+='<line x1='+ml+' y1='+(oy-gy*sc)+' x2='+(W-mr)+' y2='+(oy-gy*sc)+' stroke=#edf1f7></line>'}$('grid').innerHTML=gr;$('ground').setAttribute('x1',ml);$('ground').setAttribute('x2',W-mr);$('ground').setAttribute('y1',oy);$('ground').setAttribute('y2',oy);var pts=data.states.map(function(s){return(ox+(s.x_m-x0)*sc)+','+(oy-s.y_m*sc)}).join(' ');$('traj').setAttribute('points',pts);var la=data.states[idx(T)];$('land').setAttribute('cx',ox+(la.x_m-x0)*sc);$('land').setAttribute('cy',oy);var at=num(ev.apex_time_s,-1),ai=at>=0?idx(at):0;$('apex').setAttribute('cx',ox+(data.states[ai].x_m-x0)*sc);$('apex').setAttribute('cy',oy-data.states[ai].y_m*sc);$('scrub').max=T;$('scrub').step=T/240;$('scrub').value=0;if(tl)tl.pause();tl=CoursewarePrimitives.createTimeline({durationPhysicalS:T,onChange:render});tl.pause();render({physicalTimeS:0,demoRate:parseFloat($('rate').value),playing:false})}function render(st){if(!data)return;var t=Math.min(Math.max(num(st.physicalTimeS,0),0),T);var s=data.states[idx(t)],ev=data.events||{};$('pt').textContent=CoursewarePrimitives.formatPhysicalTime(t);$('demo').textContent=CoursewarePrimitives.formatDemoRate(num(st.demoRate,1));var x0=num(data.states[0].x_m,0),bx=ox+(s.x_m-x0)*sc,by=oy-s.y_m*sc;$('ball').setAttribute('cx',bx);$('ball').setAttribute('cy',by);var kv=7,ka=9;$('vel').setAttribute('x1',bx);$('vel').setAttribute('y1',by);$('vel').setAttribute('x2',bx+s.vx_m_s*kv);$('vel').setAttribute('y2',by-s.vy_m_s*kv);$('acc').setAttribute('x1',bx);$('acc').setAttribute('y1',by);$('acc').setAttribute('x2',bx+s.ax_m_s2*ka);$('acc').setAttribute('y2',by-s.ay_m_s2*ka);$('labV').setAttribute('x',Math.min(W-170,bx+12));$('labV').setAttribute('y',Math.max(18,by-14));$('labA').setAttribute('x',Math.min(W-210,bx+12));$('labA').setAttribute('y',Math.min(H-10,by+28));var mk=Math.max(1e-9,s.mechanical_j||1);$('eK').style.width=Math.max(0,Math.min(100,100*s.kinetic_j/mk))+'%';$('eP').style.width=Math.max(0,Math.min(100,100*s.potential_j/mk))+'%';$('eM').style.width='100%';$('ro').textContent='状态读数（来自sample）\n物理时间 t='+s.t_s.toFixed(2)+' s   播放='+(st.playing?'是':'否')+'\n位置 x='+s.x_m.toFixed(2)+' m，y='+s.y_m.toFixed(2)+' m\n分速度 vx='+s.vx_m_s.toFixed(2)+'，vy='+s.vy_m_s.toFixed(2)+' m/s\n加速度 ax='+s.ax_m_s2.toFixed(2)+'，ay='+s.ay_m_s2.toFixed(2)+' m/s²\n动能='+s.kinetic_j.toFixed(1)+' J，势能='+s.potential_j.toFixed(1)+' J，机械能='+s.mechanical_j.toFixed(1)+' J\n事件：落地时间='+num(ev.flight_time_s,0).toFixed(2)+' s；射程='+num(ev.range_m,0).toFixed(2)+' m；最高点时刻='+num(ev.apex_time_s,0).toFixed(2)+' s；最大高度='+num(ev.max_height_m,0).toFixed(2)+' m\n因果观察：ax≈0时蓝箭头水平分量不变；红箭头始终指向地面，vy持续变负，动能升、势能降、机械能守恒。'}$('bPlay').onclick=function(){tl&&tl.play()};$('bPause').onclick=function(){tl&&tl.pause()};$('bReplay').onclick=function(){tl&&tl.replay()};$('scrub').oninput=function(){tl&&tl.seek(parseFloat(this.value))};$('rate').oninput=function(){tl&&tl.setDemoRate(parseFloat(this.value))};var cs=document.querySelectorAll('[data-control]');for(var i=0;i<cs.length;i++)cs[i].addEventListener('input',build);document.addEventListener('visibilitychange',function(){if(document.hidden&&tl)tl.pause()});build();</script></body></html>"
}
