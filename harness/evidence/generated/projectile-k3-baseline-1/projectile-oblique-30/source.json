{
  "title": "斜抛与平抛：顶点、射程与能量",
  "domain": "projectile",
  "teaching_intent": "让学生在可暂停、慢放和拖动的斜抛/平抛动画中观察位置、速度分量与加速度方向如何随物理时间变化；通过调节初速度、抛射角、质量和重力，验证顶点、射程与机械能、动能、势能之间的因果关系，并发现质量改变能量读数但不改变理想抛体轨迹。",
  "model_js": "globalThis.coursewareModel=Object.freeze({sample(input){const sc=(input&&input.scenario)||{};const times=(input&&Array.isArray(input.times_s))?input.times_s:[];const num=function(v,d){const n=Number(v);return Number.isFinite(n)?n:d;};const mode=String(sc.mode||'oblique');const m=Math.max(0,num(sc.mass_kg,1));const g=num(sc.g_m_s2,9.8);const x0=num(sc.x0_m,0);const y0=Math.max(0,num(sc.y0_m,0));const v0=Math.max(0,num(sc.speed_m_s,0));let ang=num(sc.angle_deg,0);if(mode==='horizontal'){ang=0;}const th=ang*Math.PI/180;const vx0=v0*Math.cos(th);const vy0=v0*Math.sin(th);const disc=vy0*vy0+2*g*y0;const rawT=g>0?(vy0+Math.sqrt(Math.max(0,disc)))/g:0;const flight=Math.max(0,rawT);const range=vx0*flight;const apexRaw=g>0&&vy0>0?vy0/g:0;const apex=Math.min(apexRaw,flight);const maxH=y0+(g>0&&vy0>0?vy0*vy0/(2*g):0);const states=times.map(function(tv){const t=num(tv,0);const tau=Math.max(0,t);let x,y,vx,vy,ax,ay;if(tau<=flight){x=x0+vx0*tau;y=y0+vy0*tau-0.5*g*tau*tau;if(y<0){y=0;}vx=vx0;vy=vy0-g*tau;ax=0;ay=-g;}else{x=x0+range;y=0;vx=0;vy=0;ax=0;ay=0;}const ke=0.5*m*(vx*vx+vy*vy);const pe=m*g*y;const me=ke+pe;return {t_s:t,x_m:x,y_m:y,vx_m_s:vx,vy_m_s:vy,ax_m_s2:ax,ay_m_s2:ay,kinetic_j:ke,potential_j:pe,mechanical_j:me};});const events={flight_time_s:flight,range_m:range,apex_time_s:apex,max_height_m:maxH,optimal_equal_height_angle_deg:45};return {states:states,events:events};}});",
  "html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>斜抛与平抛：顶点、射程与能量</title><style>*{box-sizing:border-box}body{margin:0;background:#eef4ff;color:#17233f;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif}header{padding:24px 18px 14px;background:linear-gradient(135deg,#183a75,#2469c9);color:white}h1{margin:0 0 8px;font-size:clamp(23px,4vw,36px)}header p{margin:0;max-width:900px;line-height:1.65;color:#dceaff}.wrap{max-width:1220px;margin:auto;padding:16px;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:16px}.card{background:rgba(255,255,255,.95);border:1px solid #d7e2f4;border-radius:18px;box-shadow:0 10px 30px #183a7514;padding:14px}.stage{min-width:0}.scene{width:100%;height:auto;display:block;background:linear-gradient(#f8fbff 65%,#edf4df 65%);border-radius:14px;border:1px solid #d9e4ef}.controls{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.control{border:1px solid #dce5f2;border-radius:14px;padding:10px;background:#fbfdff}.control label{display:flex;justify-content:space-between;gap:10px;font-weight:700;font-size:14px}.control output{color:#0759b8}.control input{width:100%;min-height:44px;accent-color:#1267c7}.mode{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:10px}.mode button,.transport button{min-height:44px;border:1px solid #cbd9ec;border-radius:12px;background:white;color:#1d3557;font-weight:800;font-size:15px;cursor:pointer}.mode .on{background:#1267c7;color:white;border-color:#1267c7}.transport{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:12px}.play{background:#1267c7!important;color:white!important;border-color:#1267c7!important}.rates{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:8px}.rates button{min-height:44px;border-radius:12px;border:1px solid #cbd9ec;background:#fff;font-weight:800}.rates .on{background:#e26d21;color:white;border-color:#e26d21}.seekrow{display:grid;grid-template-columns:64px 1fr;align-items:center;gap:8px;margin-top:10px}.seekrow input{width:100%;min-height:44px;accent-color:#e26d21}.times{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.timebox{padding:10px;border-radius:12px;background:#eef5ff}.timebox b{display:block;font-size:13px;color:#526179}.timebox span{font-size:18px;font-weight:900;color:#0759b8}.side{display:grid;gap:12px;align-content:start}.read{white-space:pre-line;line-height:1.6;padding:12px;border-radius:14px;background:#102c55;color:white;min-height:92px}.facts{display:grid;grid-template-columns:1fr 1fr;gap:8px}.fact{padding:10px;border-radius:12px;background:#f1f6fd;border:1px solid #dde7f4}.fact b{display:block;font-size:12px;color:#617089}.fact span{font-size:19px;font-weight:900}.erow{display:grid;grid-template-columns:54px 1fr 80px;align-items:center;gap:8px;margin:9px 0}.bar{height:18px;border-radius:99px;background:#e7edf5;overflow:hidden}.bar i{display:block;height:100%;width:0;border-radius:99px}.k{background:#1b75d0}.p{background:#e88b22}.m{background:#37a66a}.note{font-size:13px;line-height:1.55;color:#5a6980}.legend{display:flex;flex-wrap:wrap;gap:10px;font-size:13px}.legend span:before{content:\"\";display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;background:var(--c)}@media(max-width:850px){.wrap{grid-template-columns:1fr;padding:10px}.controls{grid-template-columns:1fr}.side{grid-template-columns:1fr}}@media(max-width:390px){header{padding:20px 14px 12px}.card{padding:10px;border-radius:14px}.facts{grid-template-columns:1fr 1fr}.timebox span{font-size:16px}.erow{grid-template-columns:48px 1fr 70px}}</style><!--HARNESS_PRIMITIVES--><!--HARNESS_MODEL--></head><body><header><h1>斜抛与平抛：顶点、射程与能量</h1><p>拖动时间、慢放或调节参数，观察“向上的速度如何归零”“水平运动为何持续”“能量如何在动能与势能之间转移”。所有位置、速度、加速度和能量均来自已验收的物理模型。</p></header><main class=\"wrap\"><section class=\"card stage\"><svg class=\"scene\" viewBox=\"0 0 760 430\" role=\"img\" aria-label=\"抛体运动模拟\"><defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0L10,5L0,10z\" fill=\"context-stroke\"/></marker></defs><line x1=\"38\" x2=\"735\" y1=\"380\" y2=\"380\" stroke=\"#556f48\" stroke-width=\"4\"/><path id=\"trail\" fill=\"none\" stroke=\"#1267c7\" stroke-width=\"4\" stroke-linecap=\"round\"/><line id=\"apexline\" stroke=\"#e88b22\" stroke-dasharray=\"6 6\"/><circle id=\"apex\" r=\"6\" fill=\"#e88b22\"/><circle id=\"land\" r=\"7\" fill=\"#5b6779\"/><text id=\"apexlabel\" fill=\"#a95200\" font-weight=\"800\">顶点</text><text id=\"landlabel\" fill=\"#445066\" font-weight=\"800\">落点</text><line id=\"vx\" stroke=\"#1b75d0\" stroke-width=\"3\" marker-end=\"url(#arrow)\"/><line id=\"vy\" stroke=\"#8d49c9\" stroke-width=\"3\" marker-end=\"url(#arrow)\"/><line id=\"vv\" stroke=\"#20a464\" stroke-width=\"5\" marker-end=\"url(#arrow)\"/><line id=\"aa\" stroke=\"#e34b35\" stroke-width=\"5\" marker-end=\"url(#arrow)\"/><circle id=\"ball\" r=\"10\" fill=\"#f9c846\" stroke=\"#333\" stroke-width=\"2\"/><text id=\"vlabel\" fill=\"#17794d\" font-weight=\"900\">v</text><text id=\"alabel\" fill=\"#c43727\" font-weight=\"900\">a</text></svg><div class=\"legend\"><span style=\"--c:#1b75d0\">水平速度</span><span style=\"--c:#8d49c9\">竖直速度</span><span style=\"--c:#20a464\">合速度</span><span style=\"--c:#e34b35\">加速度</span></div><div class=\"controls\"><div class=\"mode\"><button type=\"button\" data-control data-mode=\"oblique\" class=\"on\">斜抛</button><button type=\"button\" data-control data-mode=\"horizontal\">平抛（角度取0°）</button></div><div class=\"control\"><label for=\"speed\">初速度 <output id=\"speedv\"></output></label><input id=\"speed\" data-control type=\"range\" min=\"5\" max=\"35\" step=\"0.5\"></div><div class=\"control\"><label for=\"angle\">抛射角 <output id=\"anglev\"></output></label><input id=\"angle\" data-control type=\"range\" min=\"0\" max=\"80\" step=\"1\"></div><div class=\"control\"><label for=\"mass\">质量 <output id=\"massv\"></output></label><input id=\"mass\" data-control type=\"range\" min=\"0.5\" max=\"5\" step=\"0.1\"></div><div class=\"control\"><label for=\"grav\">重力加速度 <output id=\"gravv\"></output></label><input id=\"grav\" data-control type=\"range\" min=\"5\" max=\"15\" step=\"0.5\"></div></div></section><aside class=\"side\"><section class=\"card\"><b>物理时间与演示倍率</b><div class=\"times\"><div class=\"timebox\"><b>物理时间</b><span data-physical-time>—</span></div><div class=\"timebox\"><b>演示倍率</b><span data-demo-time>—</span></div></div><div class=\"seekrow\"><span>拖动</span><input id=\"seek\" aria-label=\"拖动物理时间\" type=\"range\" min=\"0\" max=\"8\" step=\"0.02\" value=\"0\"></div><div class=\"transport\"><button type=\"button\" class=\"play\" id=\"play\">播放</button><button type=\"button\" id=\"pause\">暂停</button><button type=\"button\" data-replay id=\"replay\">回放</button></div><div class=\"rates\"><button type=\"button\" data-rate=\"0.25\">0.25×</button><button type=\"button\" data-rate=\"0.5\">0.5×</button><button type=\"button\" data-rate=\"1\" class=\"on\">1×</button><button type=\"button\" data-rate=\"2\">2×</button></div></section><section class=\"card\"><b>状态读数</b><div class=\"read\" data-readout id=\"readout\">等待模型采样…</div></section><section class=\"card\"><b>关键事件（模型输出）</b><div class=\"facts\"><div class=\"fact\"><b>顶点时间</b><span id=\"et\">—</span></div><div class=\"fact\"><b>最大高度</b><span id=\"eh\">—</span></div><div class=\"fact\"><b>飞行时间</b><span id=\"ef\">—</span></div><div class=\"fact\"><b>射程</b><span id=\"er\">—</span></div></div></section><section class=\"card\"><b>能量变化</b><div class=\"erow\"><span>动能</span><div class=\"bar\"><i id=\"bk\" class=\"k\"></i></div><b id=\"ek\">—</b></div><div class=\"erow\"><span>势能</span><div class=\"bar\"><i id=\"bp\" class=\"p\"></i></div><b id=\"ep\">—</b></div><div class=\"erow\"><span>机械能</span><div class=\"bar\"><i id=\"bm\" class=\"m\"></i></div><b id=\"em\">—</b></div><p class=\"note\">观察：上升时动能条变短、势能条变长；下降时相反。只改变质量会改变能量数值，但轨迹和加速度方向不变。</p></section><section class=\"card note\"><b>探究提示</b><br>1. 慢放到顶点，确认竖直速度箭头接近消失而水平速度仍在。<br>2. 比较 30° 与平抛的射程和最大高度。<br>3. 增大初速度，观察射程与初始动能如何共同变化。<br>4. 落地后小球保持在落点，便于继续检查最终能量。</section></aside></main><!--HARNESS_INPUT--><script>(()=>{const H=globalThis.__HARNESS_INPUT__||{},base=H.scenario||H||{};const $=id=>document.getElementById(id),speed=$('speed'),angle=$('angle'),mass=$('mass'),grav=$('grav'),seek=$('seek');const D=8,DT=.02,axis=Array.from({length:401},(_,i)=>i*DT);let states=[],events={},timeline=null,playing=false,mode=base.mode||'oblique';speed.value=base.speed_m_s??20;angle.value=base.angle_deg??30;mass.value=base.mass_kg??2;grav.value=base.g_m_s2??10;function scenario(){return{mode,speed_m_s:+speed.value,angle_deg:mode==='horizontal'?0:+angle.value,mass_kg:+mass.value,g_m_s2:+grav.value,x0_m:base.x0_m??0,y0_m:base.y0_m??0}}function labels(){speedv.textContent=(+speed.value).toFixed(1)+' m/s';anglev.textContent=(mode==='horizontal'?0:+angle.value).toFixed(0)+'°';massv.textContent=(+mass.value).toFixed(1)+' kg';gravv.textContent=(+grav.value).toFixed(1)+' m/s²';angle.disabled=mode==='horizontal';document.querySelectorAll('[data-mode]').forEach(b=>b.classList.toggle('on',b.dataset.mode===mode))}function line(id,x1,y1,dx,dy,max,len){const e=$(id),m=Math.hypot(dx,dy);if(m<1e-6||max<=0){e.setAttribute('opacity',0);return}const L=18+len*m/max,x2=x1+dx/m*L,y2=y1+dy/m*L;e.setAttribute('opacity',1);e.setAttribute('x1',x1);e.setAttribute('y1',y1);e.setAttribute('x2',x2);e.setAttribute('y2',y2)}let minX=0,maxX=1,maxY=1,vmax=1,amax=1,emax=1;function prepare(res){states=res.states;events=res.events;minX=Math.min(0,...states.map(s=>s.x_m));maxX=Math.max(1,...states.map(s=>s.x_m),events.range_m||0)*1.08;maxY=Math.max(1,...states.map(s=>s.y_m),events.max_height_m||0)*1.18;vmax=Math.max(...states.map(s=>Math.hypot(s.vx_m_s,s.vy_m_s)),1);amax=Math.max(...states.map(s=>Math.hypot(s.ax_m_s2,s.ay_m_s2)),1);emax=Math.max(...states.map(s=>Math.max(s.kinetic_j,s.potential_j,s.mechanical_j)),1);trail.setAttribute('d',states.map((s,i)=>(i?'L':'M')+X(s.x_m)+' '+Y(s.y_m)).join(' '));const ai=Math.max(0,Math.min(states.length-1,Math.round((events.apex_time_s||0)/DT))),a=states[ai];apex.setAttribute('cx',X(a.x_m));apex.setAttribute('cy',Y(a.y_m));apexline.setAttribute('x1',X(a.x_m));apexline.setAttribute('x2',X(a.x_m));apexline.setAttribute('y1',Y(a.y_m));apexline.setAttribute('y2',380);apexlabel.setAttribute('x',X(a.x_m)+8);apexlabel.setAttribute('y',Y(a.y_m)-8);land.setAttribute('cx',X(events.range_m||0));land.setAttribute('cy',380);landlabel.setAttribute('x',X(events.range_m||0)-16);landlabel.setAttribute('y',405);et.textContent=(events.apex_time_s||0).toFixed(2)+' s';eh.textContent=(events.max_height_m||0).toFixed(2)+' m';ef.textContent=(events.flight_time_s||0).toFixed(2)+' s';er.textContent=(events.range_m||0).toFixed(2)+' m'}function X(x){return 50+(x-minX)/(maxX-minX)*670}function Y(y){return 380-y/maxY*340}function render(s,st){const x=X(s.x_m),y=Y(s.y_m);ball.setAttribute('cx',x);ball.setAttribute('cy',y);line('vx',x,y,s.vx_m_s,0,vmax,72);line('vy',x,y,0,-s.vy_m_s,vmax,72);line('vv',x,y,s.vx_m_s,-s.vy_m_s,vmax,86);line('aa',x,y,s.ax_m_s2,-s.ay_m_s2,amax,52);vlabel.setAttribute('x',x+14);vlabel.setAttribute('y',y-14);alabel.setAttribute('x',x-22);alabel.setAttribute('y',y+24);document.querySelector('[data-physical-time]').textContent=CoursewarePrimitives.formatPhysicalTime(st.physicalTimeS);document.querySelector('[data-demo-time]').textContent=CoursewarePrimitives.formatDemoRate(st.demoRate);seek.value=Math.min(D,Math.max(0,st.physicalTimeS));playing=st.playing;play.textContent=playing?'播放中':'播放';document.querySelectorAll('[data-rate]').forEach(b=>b.classList.toggle('on',Math.abs(+b.dataset.rate-st.demoRate)<.01));bk.style.width=100*s.kinetic_j/emax+'%';bp.style.width=100*s.potential_j/emax+'%';bm.style.width=100*s.mechanical_j/emax+'%';ek.textContent=s.kinetic_j.toFixed(1)+' J';ep.textContent=s.potential_j.toFixed(1)+' J';em.textContent=s.mechanical_j.toFixed(1)+' J';let phase='上升：竖直速度向上并逐渐减小，动能向势能转移';if(Math.abs(s.vy_m_s)<.12&&s.y_m>0)phase='顶点附近：竖直速度接近零，水平速度仍维持运动';else if(s.vy_m_s<0&&s.y_m>0)phase='下降：竖直速度向下增大，势能向动能转移';if(st.physicalTimeS>=events.flight_time_s)phase='已落地：模型将高度保持为0，可检查最终速度与能量';readout.textContent=phase+'\n位置：x='+s.x_m.toFixed(2)+' m，y='+s.y_m.toFixed(2)+' m\n速度：水平 '+s.vx_m_s.toFixed(2)+' m/s，竖直 '+s.vy_m_s.toFixed(2)+' m/s\n加速度：'+s.ax_m_s2.toFixed(2)+'，'+s.ay_m_s2.toFixed(2)+' m/s²\n状态：'+(playing?'播放中':'已暂停')}function rebuild(){labels();const was=playing;if(timeline)timeline.pause();prepare(coursewareModel.sample({scenario:scenario(),times_s:axis}));timeline.seek(0);if(was)timeline.play()}prepare(coursewareModel.sample({scenario:scenario(),times_s:axis}));labels();timeline=CoursewarePrimitives.createTimeline({durationPhysicalS:D,onChange(st){const i=Math.max(0,Math.min(states.length-1,Math.round(st.physicalTimeS/DT)));render(states[i],st)}});[speed,angle,mass,grav].forEach(c=>c.addEventListener('input',rebuild));document.querySelectorAll('[data-mode]').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;rebuild()}));play.onclick=()=>timeline.play();pause.onclick=()=>timeline.pause();replay.onclick=()=>timeline.replay();seek.addEventListener('input',()=>timeline.seek(+seek.value));document.querySelectorAll('[data-rate]').forEach(b=>b.addEventListener('click',()=>timeline.setDemoRate(+b.dataset.rate)));document.addEventListener('visibilitychange',()=>{if(document.hidden)timeline.pause()});timeline.seek(0)})();</script></body></html>"
}
