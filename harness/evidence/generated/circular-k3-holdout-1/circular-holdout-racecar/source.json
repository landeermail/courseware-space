{
  "title": "水平圆弯道与圆周运动向心力探究",
  "domain": "circular",
  "teaching_intent": "让学生操控赛车速度与弯道半径，在暂停、慢放、拖动时间轴中观察：汽车沿水平圆弯道运动时速度方向时刻沿切线变化，而向心力（由路面摩擦力提供）始终指向圆心；通过读数对比验证向心力 F=mv²/r 的因果关系——速度加倍向心力变四倍、半径减半向心力变两倍，并感知周期随速度和半径的变化。",
  "model_js": "globalThis.coursewareModel=Object.freeze({sample(input){const s=(input&&input.scenario)||{};const angles=Array.isArray(input&&input.angles_rad)?input.angles_rad:[];const G=+s.G_n_m2_kg2||0;const M=+s.central_mass_kg||0;const g=+s.g_m_s2||0;const m=+s.mass_kg||0;const r=+s.radius_m||0;const v0=+s.speed_m_s||0;const mode=s.mode||'uniform';const states=[];function rec(a,x,y,v,ax,ay,fr,ten){const K=0.5*m*v*v;let U=0;if(mode==='orbit'){U=-G*M*m/r;}else if(mode==='vertical_string'){U=m*g*r*(1-Math.cos(a));}states.push({angle_rad:a,x_m:x,y_m:y,speed_m_s:v,ax_m_s2:ax,ay_m_s2:ay,radial_force_n:fr,tension_n:ten,kinetic_j:K,potential_j:U,mechanical_j:K+U});}let v=v0;let ac=r>0?v*v/r:0;let period=null;if(mode==='orbit'){v=(G>0&&M>0&&r>0)?Math.sqrt(G*M/r):0;ac=r>0?v*v/r:0;period=v>0?2*Math.PI*r/v:null;}else if(mode==='vertical_string'){ac=r>0?v0*v0/r:0;if(r>0){const n=8192;const h=2*Math.PI/n;let bad=false;function f(t){const q=v0*v0-2*g*r*(1-Math.cos(t));if(q<=0){bad=true;return 0;}return r/Math.sqrt(q);}let sum=f(0)+f(2*Math.PI);for(let i=1;i<n;i++){sum+=(i%2===1?4:2)*f(i*h);}period=bad?null:sum*h/3;}}else{period=v>0?2*Math.PI*r/v:null;}for(let i=0;i<angles.length;i++){const a=+angles[i]||0;if(mode==='vertical_string'){const c=Math.cos(a);const sn=Math.sin(a);const q=v0*v0-2*g*r*(1-c);const vv=q>0?Math.sqrt(q):0;const x=r*sn;const y=-r*c;const ar=r>0?vv*vv/r:0;const ax=-sn*(ar+g*c);const ay=ar*c-g*sn*sn;let ten=m*(ar+g*c);if(ten<0){ten=0;}rec(a,x,y,vv,ax,ay,m*ar,ten);}else{const c=Math.cos(a);const sn=Math.sin(a);rec(a,r*c,r*sn,v,-ac*c,-ac*sn,m*ac,0);}}const ev={period_s:period,centripetal_acceleration_m_s2:ac};if(mode==='vertical_string'){ev.critical_top_speed_m_s=Math.sqrt(Math.max(0,g*r));ev.critical_bottom_speed_m_s=Math.sqrt(Math.max(0,5*g*r));}return {states:states,events:ev};}});",
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>水平圆弯道与圆周运动向心力探究</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:\"PingFang SC\",\"Microsoft YaHei\",sans-serif;background:#f1f5f9;color:#1e293b;line-height:1.5}\nheader{background:#0f3d5c;color:#fff;padding:14px 18px}\nheader h1{font-size:19px}\nheader p{font-size:13px;opacity:.85;margin-top:4px}\nmain{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:14px;max-width:1000px;margin:0 auto}\n.stage{background:#fff;border-radius:12px;padding:10px;box-shadow:0 1px 4px rgba(0,0,0,.1)}\nsvg{width:100%;height:auto;display:block}\n.panel{display:flex;flex-direction:column;gap:12px}\n.card{background:#fff;border-radius:12px;padding:12px 14px;box-shadow:0 1px 4px rgba(0,0,0,.1)}\n.card h2{font-size:15px;color:#0f3d5c;margin-bottom:8px}\n.ctl{margin:10px 0}\n.ctl label{display:flex;justify-content:space-between;font-size:14px;font-weight:600}\n.ctl input[type=range]{width:100%;height:44px;accent-color:#0f3d5c;cursor:pointer}\n.times{display:flex;gap:10px;flex-wrap:wrap;font-size:14px}\n.times div{background:#eef6fb;border-radius:8px;padding:6px 10px;flex:1;min-width:120px}\n.times b{display:block;font-size:17px;color:#0f3d5c}\n.btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}\nbutton{min-height:44px;min-width:64px;border:none;border-radius:10px;padding:8px 14px;font-size:15px;font-weight:600;cursor:pointer;background:#0f3d5c;color:#fff}\nbutton:active{transform:scale(.96)}\nbutton.ghost{background:#e2e8f0;color:#0f3d5c}\nbutton.rate.on{background:#f59e0b;color:#1e293b}\n.ro{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:14px}\n.ro div{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:8px}\n.ro b{display:block;font-size:16px}\n.blue{color:#1d4ed8}.red{color:#dc2626}\n.hint{font-size:13px;background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:10px 12px}\n.legend{font-size:13px;display:flex;gap:16px;margin-top:6px}\n.legend span::before{content:\"\";display:inline-block;width:14px;height:4px;border-radius:2px;margin-right:5px;vertical-align:middle}\n.legend .lv::before{background:#1d4ed8}.legend .lf::before{background:#dc2626}\n@media(max-width:640px){main{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<header><h1>水平圆弯道与圆周运动向心力探究</h1><p>赛车 850 kg，驶入水平圆弯道。调节速度与半径，观察速度方向、向心力方向及其大小如何变化。</p></header>\n<!--HARNESS_PRIMITIVES-->\n<!--HARNESS_MODEL-->\n<!--HARNESS_INPUT-->\n<main>\n<section class=\"stage\">\n<svg id=\"svg\" viewBox=\"0 0 400 400\" aria-label=\"圆形弯道俯视图\">\n<defs>\n<marker id=\"ahV\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" fill=\"#1d4ed8\"/></marker>\n<marker id=\"ahF\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" fill=\"#dc2626\"/></marker>\n</defs>\n<circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"#e2e8f0\" stroke-width=\"30\"/>\n<circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\" stroke-dasharray=\"6 6\"/>\n<circle cx=\"200\" cy=\"200\" r=\"4\" fill=\"#64748b\"/>\n<line id=\"vArrow\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"0\" stroke=\"#1d4ed8\" stroke-width=\"3.5\" marker-end=\"url(#ahV)\"/>\n<line id=\"fArrow\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"0\" stroke=\"#dc2626\" stroke-width=\"4.5\" marker-end=\"url(#ahF)\"/>\n<text id=\"vLab\" font-size=\"15\" font-weight=\"700\" fill=\"#1d4ed8\">v</text>\n<text id=\"fLab\" font-size=\"15\" font-weight=\"700\" fill=\"#dc2626\">F向心</text>\n<g id=\"car\"><rect x=\"-17\" y=\"-9\" width=\"34\" height=\"18\" rx=\"6\" fill=\"#f59e0b\" stroke=\"#92400e\" stroke-width=\"1.5\"/><rect x=\"-12\" y=\"-6\" width=\"10\" height=\"12\" rx=\"3\" fill=\"#78350f\"/><circle cx=\"-10\" cy=\"10\" r=\"3.5\" fill=\"#334155\"/><circle cx=\"10\" cy=\"10\" r=\"3.5\" fill=\"#334155\"/><circle cx=\"-10\" cy=\"-10\" r=\"3.5\" fill=\"#334155\"/><circle cx=\"10\" cy=\"-10\" r=\"3.5\" fill=\"#334155\"/></g>\n</svg>\n<div class=\"legend\"><span class=\"lv\">速度 v（切线方向）</span><span class=\"lf\">向心力 F（指向圆心）</span></div>\n</section>\n<section class=\"panel\">\n<div class=\"card\">\n<h2>可调参数</h2>\n<div class=\"ctl\"><label><span>赛车速度 v</span><span id=\"vVal\" class=\"blue\"></span></label><input id=\"vCtl\" data-control=\"speed\" type=\"range\" min=\"5\" max=\"40\" step=\"1\"></div>\n<div class=\"ctl\"><label><span>弯道半径 r</span><span id=\"rVal\" class=\"blue\"></span></label><input id=\"rCtl\" data-control=\"radius\" type=\"range\" min=\"40\" max=\"200\" step=\"5\"></div>\n</div>\n<div class=\"card\">\n<h2>时间与播放</h2>\n<div class=\"times\"><div>物理时间<b data-physical-time id=\"pt\">—</b></div><div>演示倍率<b data-demo-time id=\"dr\">—</b></div><div>转一圈周期<b id=\"perR\">—</b></div></div>\n<div class=\"btns\">\n<button id=\"playBtn\">▶ 播放</button>\n<button id=\"replayBtn\" data-replay class=\"ghost\">↺ 回放</button>\n<button class=\"rate ghost\" data-rate=\"0.5\">0.5×</button>\n<button class=\"rate ghost\" data-rate=\"1\">1×</button>\n<button class=\"rate ghost\" data-rate=\"2\">2×</button>\n<button class=\"rate ghost\" data-rate=\"4\">4×</button>\n</div>\n</div>\n<div class=\"card\">\n<h2>状态读数</h2>\n<div class=\"ro\">\n<div>速度<b data-readout id=\"spdR\" class=\"blue\">—</b></div>\n<div>向心加速度<b data-readout id=\"accR\" class=\"red\">—</b></div>\n<div>所需向心力<b data-readout id=\"forceR\" class=\"red\">—</b></div>\n<div>动能<b data-readout id=\"keR\">—</b></div>\n</div>\n</div>\n<div class=\"hint\">探究任务：① 保持半径不变，把速度加倍，观察向心力变为原来的几倍；② 保持速度不变，把半径减半，向心力又怎样变？③ 慢放并拖动时间轴，注意速度箭头始终沿切线、向心力箭头始终指向圆心——正是这个力不断改变速度方向。向心力由轮胎与路面间的摩擦力提供。</div>\n</section>\n</main>\n<script>\n\"use strict\";\nvar HI=globalThis.__HARNESS_INPUT__;\nvar base=HI.scenario;\nfunction $(id){return document.getElementById(id);}\nvar vCtl=$(\"vCtl\"),rCtl=$(\"rCtl\");\nvCtl.value=base.speed_m_s;\nrCtl.value=base.radius_m;\nvar N=360,TAU=Math.PI*2;\nvar angles=[];\nfor(var i=0;i<N;i++){angles.push(i*TAU/(N-1));}\nvar states=null,periodS=1,tl=null,playing=false;\nfunction scenarioFromControls(){\nreturn {G_n_m2_kg2:base.G_n_m2_kg2,central_mass_kg:base.central_mass_kg,g_m_s2:base.g_m_s2,mass_kg:base.mass_kg,mode:base.mode,radius_m:Number(rCtl.value),speed_m_s:Number(vCtl.value)};\n}\nfunction resample(){\nvar res=coursewareModel.sample({scenario:scenarioFromControls(),angles_rad:angles});\nstates=res.states;\nperiodS=res.events.period_s;\n$(\"accR\").textContent=res.events.centripetal_acceleration_m_s2.toFixed(2)+\" m/s²\";\n$(\"perR\").textContent=CoursewarePrimitives.formatPhysicalTime(periodS);\n$(\"vVal\").textContent=Number(vCtl.value).toFixed(0)+\" m/s\";\n$(\"rVal\").textContent=Number(rCtl.value).toFixed(0)+\" m\";\nif(tl){tl.pause();}\ntl=CoursewarePrimitives.createTimeline({durationPhysicalS:periodS*2,onChange:render});\nplaying=false;\nupdatePlayBtn();\ntl.seek(0);\nrender({physicalTimeS:0,demoRate:tl&&tl.demoRate||1,playing:false});\n}\nfunction setLine(el,x1,y1,x2,y2){el.setAttribute(\"x1\",x1);el.setAttribute(\"y1\",y1);el.setAttribute(\"x2\",x2);el.setAttribute(\"y2\",y2);}\nfunction render(state){\nif(!states){return;}\nvar t=state.physicalTimeS;\n$(\"pt\").textContent=CoursewarePrimitives.formatPhysicalTime(t);\n$(\"dr\").textContent=CoursewarePrimitives.formatDemoRate(state.demoRate);\nif(state.playing!==playing){playing=state.playing;updatePlayBtn();}\nvar frac=((t%periodS)+periodS)%periodS/periodS;\nvar idx=Math.min(N-1,Math.round(frac*(N-1)));\nvar s=states[idx];\nvar R=Number(rCtl.value),cx=200,cy=200,scale=150/R;\nvar px=cx+s.x_m*scale,py=cy-s.y_m*scale;\nvar th=Math.atan2(s.y_m,s.x_m);\nvar rot=-(th*180/Math.PI+90);\n$(\"car\").setAttribute(\"transform\",\"translate(\"+px.toFixed(1)+\" \"+py.toFixed(1)+\") rotate(\"+rot.toFixed(1)+\")\");\nvar tvx=-Math.sin(th),tvy=-Math.cos(th);\nvar vl=s.speed_m_s*1.8;\nsetLine($(\"vArrow\"),px,py,px+tvx*vl,py+tvy*vl);\n$(\"vLab\").setAttribute(\"x\",px+tvx*(vl+14)-6);\n$(\"vLab\").setAttribute(\"y\",py+tvy*(vl+14)+5);\nvar fx=-Math.cos(th),fy=Math.sin(th);\nvar fl=Math.min(125,s.radial_force_n*0.018);\nsetLine($(\"fArrow\"),px,py,px+fx*fl,py+fy*fl);\n$(\"fLab\").setAttribute(\"x\",px+fx*(fl+16)-16);\n$(\"fLab\").setAttribute(\"y\",py+fy*(fl+16)+5);\n$(\"spdR\").textContent=s.speed_m_s.toFixed(1)+\" m/s\";\n$(\"forceR\").textContent=Math.round(s.radial_force_n)+\" N\";\n$(\"keR\").textContent=Math.round(s.kinetic_j)+\" J\";\n}\nfunction updatePlayBtn(){$(\"playBtn\").textContent=playing?\"⏸ 暂停\":\"▶ 播放\";}\n$(\"playBtn\").addEventListener(\"click\",function(){if(!tl){return;}if(playing){tl.pause();}else{tl.play();}});\n$(\"replayBtn\").addEventListener(\"click\",function(){if(tl){tl.replay();}});\nvar rateBtns=document.querySelectorAll(\"button.rate\");\nrateBtns.forEach(function(b){b.addEventListener(\"click\",function(){if(tl){tl.setDemoRate(Number(b.getAttribute(\"data-rate\")));}rateBtns.forEach(function(x){x.classList.remove(\"on\");});b.classList.add(\"on\");});});\nvCtl.addEventListener(\"input\",resample);\nrCtl.addEventListener(\"input\",resample);\ndocument.addEventListener(\"visibilitychange\",function(){if(document.hidden&&tl){tl.pause();}});\nresample();\n</script>\n</body>\n</html>"
}
