{
  "title": "竖直圆周与轨道运动纯物理模型",
  "domain": "circular",
  "teaching_intent": "让学生把竖直圆周中“高度升高—速度下降—张力变化—能量转化”的因果链可视化：拖动质量、绳长、最低点速度后重新采样，暂停/慢放/拖动到任意物理时刻，比较最低点与最高点的速度、向心加速度、绳子张力、动能/势能/机械能，并观察临界最高点与最低点速度随参数改变而变化。",
  "model_js": "globalThis.coursewareModel=Object.freeze({sample(input){const sc=(input&&input.scenario)||{};const angles=(input&&Array.isArray(input.angles_rad))?input.angles_rad:[0,Math.PI/2,Math.PI,3*Math.PI/2];const G=Number(sc.G_n_m2_kg2)||0,M=Number(sc.central_mass_kg)||0,g=Number(sc.g_m_s2)||0,m=Number(sc.mass_kg)||0,r=Number(sc.radius_m)||0,v0=Number(sc.speed_m_s)||0,mode=String(sc.mode||\"uniform\");const tau=2*Math.PI;function speed2(th){if(mode===\"orbit\"){return (r>0&&M>0)?G*M/r:0;}if(mode===\"vertical_string\"){return v0*v0-2*g*r*(1-Math.cos(th));}return v0*v0;}function periodVertical(){const n=65536;let ok=true;function f(th){const q=speed2(th);if(q<=1e-15){ok=false;return Infinity;}return r/Math.sqrt(q);}let h=tau/n,s=f(0)+f(tau);for(let i=1;i<n;i++){s+=(i%2?4:2)*f(i*h);}return ok?{period_s:s*h/3}:{period_s:null};}const states=angles.map((a)=>{let th=Number(a)||0,x,y,v2,v,ax,ay;v2=speed2(th);if(v2<0&&mode!==\"orbit\"){v2=0;}v=Math.sqrt(Math.max(0,v2));const ac=r>0?v2/r:0;if(mode===\"orbit\"){x=r*Math.cos(th);y=r*Math.sin(th);ax=-ac*Math.cos(th);ay=-ac*Math.sin(th);}else{x=r*Math.sin(th);y=r*(1-Math.cos(th));ax=-ac*Math.sin(th);ay=ac*Math.cos(th);}let radial,tension,ke,pe,mech;radial=m*ac;ke=0.5*m*v2;if(mode===\"orbit\"){tension=0;pe=(M>0&&r>0)?-G*M*m/r:0;mech=ke+pe;}else if(mode===\"vertical_string\"){tension=m*(ac+g*Math.cos(th));pe=m*g*y;mech=ke+pe;}else{tension=radial;pe=m*g*y;mech=ke+pe;}return {angle_rad:th,x_m:x,y_m:y,speed_m_s:v,ax_m_s2:ax,ay_m_s2:ay,radial_force_n:radial,tension_n:tension,kinetic_j:ke,potential_j:pe,mechanical_j:mech};});let period=null;if(mode===\"vertical_string\"){period=periodVertical().period_s;}else if(r>0){const vv=speed2(0);const vv2=Math.max(0,vv);period=vv2>0?tau*r/Math.sqrt(vv2):null;}const cent=r>0?Math.max(0,speed2(0))/r:0;const events={period_s:period,centripetal_acceleration_m_s2:cent};if(mode===\"vertical_string\"){events.critical_top_speed_m_s=Math.sqrt(Math.max(0,g*r));events.critical_bottom_speed_m_s=Math.sqrt(Math.max(0,5*g*r));}return {states:states,events:events};}});",
  "html": "<!DOCTYPE html><html lang='zh-CN'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>竖直圆周与轨道运动纯物理模型</title><style>:root{--bg:#0b1020;--card:#151d33;--ink:#eaf0ff;--mut:#9aa8c7;--acc:#6ee7b7;--warn:#ffd166;--bad:#ff6b6b}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0%,#1b2a52,#0b1020 60%);color:var(--ink);font:15px/1.45 system-ui,-apple-system,Segoe UI,sans-serif}.wrap{max-width:1080px;margin:0 auto;padding:14px}h1{font-size:20px;margin:4px 0 10px}.grid{display:grid;grid-template-columns:1.15fr .85fr;gap:12px}.card{background:rgba(21,29,51,.9);border:1px solid #2b3a63;border-radius:14px;padding:12px;box-shadow:0 8px 24px #0006}.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.ctl{flex:1 1 190px}.ctl label{display:block;color:var(--mut);font-size:13px}.ctl input{width:100%;min-height:44px;accent-color:var(--acc)}button,select{min-height:44px;min-width:64px;border:0;border-radius:10px;background:#26365f;color:var(--ink);padding:0 14px;font-weight:700}button:active{transform:translateY(1px)}.primary{background:#2f855a}.read{font-variant-numeric:tabular-nums;background:#0d1528;border:1px solid #33436f;border-radius:10px;padding:8px 10px}.big{font-size:18px;color:var(--acc)}svg{width:100%;height:auto;display:block;background:linear-gradient(#101a33,#0b1224);border-radius:12px}.mut{color:var(--mut)}.ok{color:var(--acc)}.warn{color:var(--warn)}.bad{color:var(--bad)}.cmp{display:grid;grid-template-columns:1fr 1fr;gap:8px}.pill{border-radius:10px;padding:8px;background:#0e1730;border:1px solid #2c3c68}.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 10px}.kv b{text-align:right}.note{font-size:13px;color:var(--mut)}@media(max-width:760px){.grid{grid-template-columns:1fr}.wrap{padding:10px}h1{font-size:18px}}</style></head><body><!--HARNESS_PRIMITIVES--><!--HARNESS_MODEL--><!--HARNESS_INPUT--><div class='wrap'><h1>竖直圆周：最低点进入后的速度、张力与能量</h1><div class='grid'><section class='card'><div class='row' style='justify-content:space-between'><span class='read'>物理时间 <b data-physical-time class='big'>—</b></span><span class='read'>演示倍率 <b data-demo-time class='big'>—</b></span></div><svg viewBox='0 0 360 340' role='img' aria-label='竖直圆周动画'><defs><marker id='ar' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'><path d='M0 0L10 5L0 10z' fill='#ffd166'/></marker><marker id='ab' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'><path d='M0 0L10 5L0 10z' fill='#6ee7b7'/></marker></defs><circle id='ring' cx='170' cy='170' r='120' fill='none' stroke='#54658f' stroke-width='3'/><circle cx='170' cy='170' r='4' fill='#aab7d8'/><line id='rope' x1='170' y1='170' x2='170' y2='290' stroke='#cbd5e1' stroke-width='3'/><line id='vArr' x1='0' y1='0' x2='0' y2='0' stroke='#ffd166' stroke-width='4' marker-end='url(#ar)'/><line id='aArr' x1='0' y1='0' x2='0' y2='0' stroke='#6ee7b7' stroke-width='4' marker-end='url(#ab)'/><circle id='ball' cx='170' cy='290' r='14' fill='#7dd3fc' stroke='#082f49' stroke-width='3'/><text x='12' y='24' fill='#9aa8c7' font-size='13'>黄:速度方向 绿:加速度/径向受力方向</text></svg><div class='row'><button id='play' class='primary'>播放</button><button data-replay id='replay'>回放</button><label class='mut'>倍率 <select id='rate'><option>0.25</option><option>0.5</option><option selected>1</option><option>1.5</option><option>2</option><option>4</option></select></label><span class='read' id='pos'>角度 —</span></div></section><aside class='card'><div class='ctl'><label>最低点速度 v₀ (m/s)：<b id='sv'>—</b></label><input data-control='speed' id='speed' type='range' min='3' max='20' step='0.1'></div><div class='ctl'><label>绳长/半径 r (m)：<b id='sr'>—</b></label><input data-control='radius' id='radius' type='range' min='0.8' max='5' step='0.1'></div><div class='ctl'><label>质量 m (kg)：<b id='sm'>—</b></label><input data-control='mass' id='mass' type='range' min='0.5' max='8' step='0.1'></div><div class='read' data-readout id='readout'>等待模型采样…</div><div class='note'>先由确认场景初始化；只有拖动控件后才重新构造 scenario 并调用 sample()。页面不计算物理量，只显示 sample() 的 states/events。</div></aside></div><div class='grid' style='margin-top:12px'><section class='card'><h2 style='margin:0 0 8px;font-size:16px'>最低点 vs 最高点（取自采样状态）</h2><div class='cmp'><div class='pill'><b class='ok'>最低点 θ=0</b><div class='kv' id='bot'></div></div><div class='pill'><b class='warn'>最高点 θ=π</b><div class='kv' id='top'></div></div></div></section><section class='card'><h2 style='margin:0 0 8px;font-size:16px'>临界与周期事件</h2><div class='kv' id='events'></div><p class='note'>观察：增大 v₀ 会提高全程速度与张力和机械能；增大 r 或改变 m 会改变临界条件与张力分布。播放只会由你点击触发，可用暂停、慢放与拖动定位因果瞬间。</p></section></div></div><script>(function(){'use strict';const H=globalThis.__HARNESS_INPUT__;const M=globalThis.coursewareModel;const P=globalThis.CoursewarePrimitives;const q=id=>document.getElementById(id);const base=Object.assign({},H.scenario);const speed=q('speed'),radius=q('radius'),mass=q('mass');speed.value=base.speed_m_s;radius.value=base.radius_m;mass.value=base.mass_kg;q('sv').textContent=speed.value;q('sr').textContent=radius.value;q('sm').textContent=mass.value;const N=721;function angles(){const a=[];for(let i=0;i<N;i++)a.push(i/(N-1)*2*Math.PI);return a}let res=null,timeline=null,lastState={physicalTimeS:0,demoRate:1,playing:false};function fmt(x,d){return Number.isFinite(x)?x.toFixed(d===undefined?2:d):'—'}function setKV(el,o){el.innerHTML=o.map(p=>'<span class=mut>'+p[0]+'</span><b>'+p[1]+'</b>').join('')}function findState(target){let best=res.states[0],bd=1e9;for(const s of res.states){const d=Math.abs(s.angle_rad-target);if(d<bd){bd=d;best=s}}return best}function rebuild(){res=M.sample({scenario:Object.assign({},base),angles_rad:angles()});timeline=P.createTimeline({durationPhysicalS:Math.max(res.events.period_s,1e-6),onChange:render});timeline.pause();timeline.seek(0);lastState={physicalTimeS:0,demoRate:1,playing:false};render(lastState)}function arrow(el,x,y,vx,vy,scale,maxLen){const m=Math.hypot(vx,vy);if(m<1e-9){el.setAttribute('x2',x);el.setAttribute('y2',y);return}let ex=x+vx*scale,ey=y-vy*scale;const L=Math.hypot(ex-x,ey-y);if(L>maxLen){ex=x+(ex-x)/L*maxLen;ey=y+(ey-y)/L*maxLen}el.setAttribute('x1',x);el.setAttribute('y1',y);el.setAttribute('x2',ex);el.setAttribute('y2',ey)}function render(st){lastState=st;if(!res)return;const dur=Math.max(res.events.period_s,1e-9);const idx=Math.max(0,Math.min(res.states.length-1),Math.round(st.physicalTimeS/dur*(res.states.length-1)));const s=res.states[idx];const cx=170,cy=170,scale=120/base.radius_m;const bx=cx+s.x_m*scale,by=cy-s.y_m*scale;q('ball').setAttribute('cx',bx);q('ball').setAttribute('cy',by);q('rope').setAttribute('x2',bx);q('rope').setAttribute('y2',by);const rr=Math.hypot(s.x_m,s.y_m)||1,rx=-s.x_m/rr,ry=s.y_m/rr;arrow(q('vArr'),bx,by,speedTangent(s),0,0,1);const tvx=-(s.x_m/rr)*s.speed_m_s,tvy=(s.y_m/rr)*s.speed_m_s;arrow(q('vArr'),bx,by,tvx,tvy,4,58);arrow(q('aArr'),bx,by,rx*s.ax_m_s2+ry*s.ay_m_s2?rx:rx,0,0,1);arrow(q('aArr'),bx,by,rx*Math.hypot(s.ax_m_s2,s.ay_m_s2),ry*Math.hypot(s.ax_m_s2,s.ay_m_s2),5,58);q('pos').textContent='角度 '+fmt(s.angle_rad,3)+' rad · v '+fmt(s.speed_m_s)+' m/s';document.querySelector('[data-physical-time]').textContent=P.formatPhysicalTime(st.physicalTimeS);document.querySelector('[data-demo-time]').textContent=P.formatDemoRate(st.demoRate);q('play').textContent=st.playing?'暂停':'播放';q('readout').innerHTML='当前：v <b class=warn>'+fmt(s.speed_m_s)+'</b> m/s，a <b>'+fmt(Math.hypot(s.ax_m_s2,s.ay_m_s2))+'</b> m/s²，T <b class=ok>'+fmt(s.tension_n)+'</b> N，Ek <b>'+fmt(s.kinetic_j)+'</b> J，Ep <b>'+fmt(s.potential_j)+'</b> J，E <b class=ok>'+fmt(s.mechanical_j)+'</b> J';const b=findState(0),t=findState(Math.PI);setKV(q('bot'),[['速度',fmt(b.speed_m_s)+' m/s'],['张力',fmt(b.tension_n)+' N'],['动能',fmt(b.kinetic_j)+' J'],['势能',fmt(b.potential_j)+' J'],['机械能',fmt(b.mechanical_j)+' J']]);setKV(q('top'),[['速度',fmt(t.speed_m_s)+' m/s'],['张力',fmt(t.tension_n)+' N'],['动能',fmt(t.kinetic_j)+' J'],['势能',fmt(t.potential_j)+' J'],['机械能',fmt(t.mechanical_j)+' J']]);setKV(q('events'),[['周期',fmt(res.events.period_s,3)+' s'],['向心加速度(事件)',fmt(res.events.centripetal_acceleration_m_s2)+' m/s²'],['临界最高点速度',fmt(res.events.critical_top_speed_m_s)+' m/s'],['临界最低点速度',fmt(res.events.critical_bottom_speed_m_s)+' m/s'],['当前是否触顶有效',t.tension_n>=0?'张力非负':'松弛/不成立']])}function speedTangent(){return 0}function userChanged(){base.speed_m_s=+speed.value;base.radius_m=+radius.value;base.mass_kg=+mass.value;q('sv').textContent=speed.value;q('sr').textContent=radius.value;q('sm').textContent=mass.value;rebuild()}[speed,radius,mass].forEach(c=>c.addEventListener('input',userChanged));q('play').addEventListener('click',()=>{if(!timeline)return;if(lastState.playing)timeline.pause();else timeline.play()});q('replay').addEventListener('click',()=>timeline&&timeline.replay());q('rate').addEventListener('change',e=>timeline&&timeline.setDemoRate(+e.target.value));document.addEventListener('visibilitychange',()=>{if(document.hidden&&timeline&&lastState.playing)timeline.pause()});rebuild()})();</script></body></html>"
}
