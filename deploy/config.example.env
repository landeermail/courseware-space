export COURSEWARE_CORS_ORIGINS=https://landeermail.github.io
export COURSEWARE_RATE_LIMIT_PER_CLIENT=30
export COURSEWARE_RATE_LIMIT_GLOBAL=80
export COURSEWARE_RATE_LIMIT_WINDOW=600

