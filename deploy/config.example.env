# 非敏感配置示例；不要在本文件填写或提交任何 AccessKey/Kimi key。
export COURSEWARE_OSS_REGION=cn-hangzhou
export COURSEWARE_OSS_BUCKET=courseware-space-demo-unique-suffix
export COURSEWARE_FC_FUNCTION=courseware-space-generator
export COURSEWARE_FC_TRIGGER=courseware-space-http
export COURSEWARE_FC_ROLE=courseware-space-fc-role
export COURSEWARE_FC_POLICY=courseware-space-oss-staging-write
