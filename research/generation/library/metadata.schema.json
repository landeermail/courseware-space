{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landeermail.github.io/courseware-space/library/metadata.schema.json",
  "title": "互动课件元数据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "owner",
    "status",
    "source_input_type",
    "physics_summary",
    "generated_at",
    "path",
    "review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 80},
    "title": {"type": "string", "minLength": 4, "maxLength": 120},
    "owner": {"type": "string", "minLength": 1, "maxLength": 80},
    "status": {"enum": ["pending_review", "published", "rejected"]},
    "source_input_type": {"enum": ["text", "image", "pdf", "manual"]},
    "physics_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "parameters", "magnetic_direction", "motion_direction", "current_direction", "asks"],
      "properties": {
        "topic": {"type": "string", "minLength": 2, "maxLength": 120},
        "parameters": {
          "type": "object",
          "additionalProperties": {"type": ["number", "string", "boolean", "null"]}
        },
        "magnetic_direction": {"type": ["string", "null"], "maxLength": 120},
        "motion_direction": {"type": ["string", "null"], "maxLength": 120},
        "current_direction": {"type": ["string", "null"], "maxLength": 120},
        "asks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "path": {"type": "string", "pattern": "^[a-z0-9][A-Za-z0-9_./-]*/$"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "physics_confirmed"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 80},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "physics_confirmed": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "published"}}},
      "then": {
        "properties": {
          "review": {
            "properties": {
              "reviewed_at": {"type": "string", "format": "date-time"},
              "physics_confirmed": {"const": true}
            }
          }
        }
      }
    }
  ]
}
